# Sao chép thành .env.production trên aaPanel (KHÔNG commit bản thật) — dùng bởi docker-compose.prod.yml.
# Chỉ chứa biến cho BACKEND — frontend deploy trên Vercel, cấu hình env riêng ở dashboard Vercel
# (biến NEXT_PUBLIC_API_URL), không dùng file này. Hướng dẫn đầy đủ: mục 11-12 trong
# docs/khomanguon-v2-spec.html.

POSTGRES_USER=khomanguon
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=khomanguon

DATABASE_URL=postgresql://khomanguon:change-me-strong-password@postgres:5432/khomanguon?schema=public
REDIS_URL=redis://redis:6379

PORT=4000
NODE_ENV=production
# Domain thật của frontend trên Vercel — bắt buộc đúng để CORS + cookie cross-site hoạt động
FRONTEND_URL=https://khomanguon.vn

JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_DAYS=30

# R2/S3 và SePay cấu hình qua trang Admin (Phase 3), không cần đặt ở đây.

# Key gốc mã hoá secretAccessKey của StorageProvider (AES-256-GCM) — bắt buộc, đổi khác dev.
STORAGE_SECRET_KEY=
