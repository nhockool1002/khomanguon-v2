# Sao chép file này thành .env khi chạy local (pnpm run start:dev ngoài Docker,
# trỏ vào Postgres/Redis do docker-compose ở thư mục gốc chạy sẵn).

DATABASE_URL="postgresql://khomanguon:khomanguon_dev_pass@localhost:5433/khomanguon?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=4000
FRONTEND_URL="http://localhost:3000"

JWT_ACCESS_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="dev-only-change-me-too"
JWT_REFRESH_TTL_DAYS=30

MAIL_FROM="khomanguon <admin@khomanguon.org>"
# Bỏ trống 4 biến dưới đây -> MailService tự log email ra console (đủ để test flow ở local)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

SEED_ADMIN_EMAIL="admin@khomanguon.local"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# R2/S3, SePay sẽ cấu hình qua trang Admin (Phase 3) — không cần đặt ở đây cho dev ban đầu.

# Key gốc để mã hoá secretAccessKey của StorageProvider trước khi lưu DB (AES-256-GCM,
# xem backend/src/common/secret-crypto.util.ts) — đổi giá trị thật khi deploy Production.
STORAGE_SECRET_KEY="dev-only-change-me-storage-secret"
