# Sao chép file này thành .env khi chạy local (pnpm run start:dev ngoài Docker,
# trỏ vào Postgres/Redis do docker-compose ở thư mục gốc chạy sẵn).

DATABASE_URL="postgresql://khomanguon:khomanguon_dev_pass@localhost:5433/khomanguon?schema=public"
REDIS_URL="redis://localhost:6379"

PORT=4000
FRONTEND_URL="http://localhost:3000"

JWT_ACCESS_SECRET="dev-only-change-me"
JWT_REFRESH_SECRET="dev-only-change-me-too"

# R2/S3, SePay sẽ cấu hình qua trang Admin (Phase 3) — không cần đặt ở đây cho dev ban đầu.
