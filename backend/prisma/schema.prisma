// khomanguon v2 — schema khởi tạo Phase 0, theo ERD trong /PLAN.md
// Các module Phase 2/3 (SEO nâng cao, custom role UI, chi tiết ví...) sẽ mở rộng thêm khi triển khai.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Người dùng & phân quyền (RBAC) ─────────────────────────

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  displayName         String
  avatarUrl           String?
  bio                 String?
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Đổi tên hiển thị: Super Moderator trở lên (quyền user.manage) đổi tự do; Moderator trở xuống
  // chỉ đổi được 1 lần — null nghĩa là còn quyền đổi miễn phí, có giá trị nghĩa là đã dùng hết
  // (xem users.service.ts updateProfile).
  displayNameChangedAt DateTime?

  // User thuộc nhiều role thì tự chọn 1 role để áp style hiển thị tên (màu/đậm/nghiêng/font) —
  // để trống thì tự fallback về role gán sớm nhất (xem roles/style-role.util.ts resolveStyleRoleSlug).
  primaryRoleId String?
  primaryRole   Role?   @relation("UserPrimaryRole", fields: [primaryRoleId], references: [id], onDelete: SetNull)

  // Bật/tắt popup gợi ý bài viết ngẫu nhiên góc phải màn hình (frontend/src/components/post-popup.tsx)
  // — mặc định bật, user tự tắt ở trang Tài khoản nếu thấy phiền.
  showPostPopup Boolean @default(true)

  // User Title — dòng chữ tự chọn hiện cạnh tên ở trang hồ sơ (khác Role.title, vốn là nhãn CHUNG
  // của cả role). Giới hạn độ dài/HTML/tần suất đổi do role của user quy định (xem
  // Role.userTitle* bên dưới + users.service.ts resolveUserTitleConfig) — null nghĩa là chưa từng
  // đổi (được đổi ngay lần đầu bất kể cooldown, giống cơ chế displayNameChangedAt).
  title          String?
  titleUpdatedAt DateTime?

  roles                  UserRole[]
  wallet                 Wallet?
  posts                  Post[]
  comments               Comment[]
  commentLikes           CommentLike[]
  downloadGrants         DownloadGrant[]
  downloadEvents         DownloadEvent[]
  linkReportsSubmitted   LinkReport[]    @relation("LinkReportReporter")
  linkReportsResolved    LinkReport[]    @relation("LinkReportResolvedBy")
  feedbacksSubmitted     Feedback[]      @relation("FeedbackAuthor")
  feedbacksResolved      Feedback[]      @relation("FeedbackResolvedBy")
  bookmarks              PostBookmark[]
  activities             UserActivity[]
  auditLogs              AuditLog[]
  refreshTokens          RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  topupOrders            TopupOrder[]
  subscriptionOrders      SubscriptionOrder[]
  subscriptionMemberships SubscriptionMembership[]
  notificationsReceived  Notification[] @relation("NotificationRecipient")
  notificationsCaused    Notification[] @relation("NotificationActor")
  uploadedMediaFiles     MediaFile[]
  profileMessagesReceived ProfileMessage[] @relation("ProfileMessagesReceived")
  profileMessagesSent     ProfileMessage[] @relation("ProfileMessagesSent")
  uploadedCloudFiles      CloudUploadRecord[]

  @@map("users")
}

// Lời nhắn công khai trên trang profile của user (giống guestbook) — bất kỳ user đăng nhập nào
// cũng để lại được, xoá được bởi chính tác giả, chủ profile, hoặc Moderator+ (comment.moderate).
model ProfileMessage {
  id            String   @id @default(cuid())
  profileUserId String
  profileUser   User     @relation("ProfileMessagesReceived", fields: [profileUserId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation("ProfileMessagesSent", fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  createdAt     DateTime @default(now())

  @@map("profile_messages")
}

// Token opaque gửi qua email — chỉ lưu bản hash (sha256), không lưu token gốc (UC01)
model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("email_verification_tokens")
}

// UC03 — hết hạn 15 phút, one-time use
model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Refresh token xoay vòng (rotate mỗi lần dùng) — cho phép thu hồi từng phiên khi logout/đổi mật khẩu
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("refresh_tokens")
}

// Vai trò chỉ là một tập hợp quyền — Admin có thể tạo Custom Role bằng cách
// tick permission trong RolePermission, không hard-code trong code (xem mục 06 docs/khomanguon-v2-spec.html).
model Role {
  id         String   @id @default(cuid())
  name       String   @unique
  slug       String   @unique
  isSystem   Boolean  @default(false) // true cho 4 role mặc định, không cho xoá
  createdAt  DateTime @default(now())

  // Style badge hiển thị công khai (cạnh bình luận, byline bài viết...) — title để trống thì
  // FE tự dùng name. fontFamily là key trong FONT_OPTIONS (xem roles/font-options.constant.ts).
  title      String?
  color      String?
  bold       Boolean  @default(false)
  italic     Boolean  @default(false)
  fontFamily String?

  // Cấu hình User Title cho MỌI user thuộc role này (users/user-title.util.ts gộp theo hướng "ưu
  // tiên nhất" khi user có nhiều role — max độ dài, OR cho phép HTML, cooldown null thắng số cụ
  // thể). null ở userTitleCooldownDays nghĩa là đổi tự do, không giới hạn ngày.
  userTitleCooldownDays Int?    @default(60)
  userTitleAllowHtml    Boolean @default(false)
  userTitleMaxLength    Int     @default(150)

  users            UserRole[]
  permissions      RolePermission[]
  menus            MenuRole[]
  widgets          WidgetRole[]
  primaryForUsers  User[]           @relation("UserPrimaryRole")

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // vd: "post.publish", "wallet.adjust"
  description String

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ───────────────────────── Nội dung: bài viết, danh mục, menu, bình luận ─────────────────────────

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
}

model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  order    Int        @default(0)
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  posts Post[]

  @@map("categories")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  posts PostTag[]

  @@map("tags")
}

model Post {
  id           String     @id @default(cuid())
  title        String
  slug         String     @unique
  excerpt      String?
  contentHtml  String
  thumbnailUrl String?
  status       PostStatus @default(DRAFT)
  viewCount    Int        @default(0)

  // SEO — UC14
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?
  // JSON-LD (schema.org Article) tuỳ chỉnh — để trống thì FE tự sinh từ title/excerpt/thumbnailUrl/
  // author/publishedAt (xem frontend bai-viet/[slug]/page.tsx buildJsonLd()); có giá trị thì FE dùng
  // thẳng chuỗi JSON này (validate parse được, fallback về tự sinh nếu hỏng — không có gì đảm bảo
  // Admin nhập JSON hợp lệ 100%).
  jsonLd String?

  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags          PostTag[]
  comments      Comment[]
  downloadLinks DownloadLink[]
  notifications Notification[]
  bookmarks     PostBookmark[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posts")
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// "Lưu bài viết" (UC bổ sung 2026-08-10) — unique theo user+post để không lưu trùng, cùng pattern
// CommentLike (toggle qua tồn tại/không tồn tại record, không có cột riêng nào khác).
model PostBookmark {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_bookmarks")
}

// Menu đa cấp — cây tự tham chiếu, thứ tự/cấp độ cập nhật qua kéo-thả (UC16)
model Menu {
  id           String  @id @default(cuid())
  label        String
  url          String
  icon         String?
  order        Int     @default(0)
  openInNewTab Boolean @default(false)
  parentId     String?
  parent       Menu?   @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Menu[]  @relation("MenuTree")

  visibleTo MenuRole[] // rỗng = hiển thị công khai

  @@map("menus")
}

model MenuRole {
  menuId String
  roleId String
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([menuId, roleId])
  @@map("menu_roles")
}

enum WidgetType {
  SEARCH
  CATEGORIES
  RECENT_POSTS
  HTML
  // Khác các loại còn lại — không tự thân đủ dữ liệu để render (cần postId của trang đang xem),
  // nên chỉ hiển thị thật khi WidgetArea được gọi kèm postId (trang bài viết); các trang khác
  // (trang chủ) coi như không có postId thì bỏ qua loại widget này dù đã cấu hình hiện.
  COMMENTS
  // Top bài viết xem nhiều nhất — dùng chung config {limit} với RECENT_POSTS, sort theo viewCount.
  TOP_VIEWED
  // Bài viết liên quan (cùng danh mục/tag với bài đang xem) — cùng nhóm "cần postId" với COMMENTS,
  // dùng chung config {limit} với RECENT_POSTS/TOP_VIEWED.
  RELATED_POSTS
}

// Widget sidebar kiểu WordPress — danh sách phẳng (không cây như Menu), thứ tự cập nhật qua kéo-thả.
// `area` để dành mở rộng thêm vùng khác (footer...) sau này, hiện chỉ dùng "sidebar".
model Widget {
  id        String     @id @default(cuid())
  type      WidgetType
  title     String // để trống = không hiện tiêu đề khối
  area      String     @default("sidebar")
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  config    Json? // {limit} cho RECENT_POSTS, {html} cho HTML — rỗng với SEARCH/CATEGORIES
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  visibleTo WidgetRole[] // rỗng = hiển thị công khai, giống MenuRole

  @@map("widgets")
}

model WidgetRole {
  widgetId String
  roleId   String
  widget   Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([widgetId, roleId])
  @@map("widget_roles")
}

enum CommentStatus {
  PUBLISHED
  HIDDEN
  PENDING
}

model Comment {
  id        String        @id @default(cuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  parentId  String?
  parent    Comment?      @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentTree")
  content   String
  status    CommentStatus @default(PUBLISHED)
  pinned    Boolean       @default(false) // Moderator ghim — UC08
  createdAt DateTime      @default(now())

  likes         CommentLike[]
  notifications Notification[]

  // Trước đây không có index nào ngoài khoá chính — bảng phình lên là ORDER BY createdAt / WHERE
  // postId / WHERE status đều phải quét toàn bảng (lỗi thật đã gặp: trang Quản lý bình luận load
  // rất chậm). 3 index bên dưới phủ đủ 3 kiểu truy vấn đang dùng: theo bài viết (comments.service.ts
  // list/listForModeration), theo trạng thái (listAllForModeration có lọc status), và không lọc gì
  // (listAllForModeration mặc định "Tất cả trạng thái").
  @@index([postId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("comments")
}

// "Thích" bình luận (UC07) — unique theo user+comment để không thích 2 lần.
model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
  @@map("comment_likes")
}

enum NotificationType {
  MENTION
}

// Thông báo @mention trong bình luận — actorId là người gõ @, userId là người bị nhắc tới.
// Chỉ 1 loại MENTION hiện tại; không làm thông báo cho like/reply (ngoài phạm vi yêu cầu).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  actorId   String
  actor     User             @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ───────────────────────── Lưu trữ file & link tải trả phí (Phase 3) ─────────────────────────

enum StorageProviderType {
  R2
  S3
  // Không phải file storage — email API (SMTP relay in-v3.mailjet.com), lưu cùng bảng để tái dùng
  // cơ chế mã hoá secret + UI "Cài đặt Storage" đã có, xem MailService cho phần dùng thật.
  MAILJET
}

model StorageProvider {
  id       String              @id @default(cuid())
  type     StorageProviderType
  label    String
  endpoint String? // R2 cần accountId/endpoint, S3 dùng region
  region   String?
  // Không áp dụng cho MAILJET — để trống.
  bucket       String?
  uploadPrefix String?
  // MAILJET: accessKeyId = API Key, secretAccessKeyEncrypted = Secret Key (SMTP user/pass).
  accessKeyId String
  // Secret không lưu plaintext — mã hoá ở tầng application trước khi ghi DB (xem UC20).
  secretAccessKeyEncrypted String
  isDefault                Boolean             @default(false)
  createdAt                DateTime            @default(now())
  // Domain public của bucket (R2 custom domain/r2.dev, S3 static hosting/CloudFront) — chỉ cần khi
  // dùng Provider này làm nguồn Thư viện Media (media.service.ts), vì ảnh nhúng trong bài viết cần
  // URL vĩnh viễn, không thể dùng presigned URL (hết hạn sau vài phút). Provider chưa cấu hình field
  // này vẫn dùng bình thường cho "Quản lý File Cloud"/download link (luôn presigned) như cũ.
  publicBaseUrl String?

  downloadLinks DownloadLink[]
  mediaFiles    MediaFile[]

  @@map("storage_providers")
}

model DownloadLink {
  id                String          @id @default(cuid())
  postId            String
  post              Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  label             String
  storageProviderId String
  storageProvider   StorageProvider @relation(fields: [storageProviderId], references: [id])
  objectKey         String
  sizeBytes         BigInt?
  priceP            Int             @default(0) // giá tính bằng $P, 0 = miễn phí
  createdAt         DateTime        @default(now())

  grants DownloadGrant[]
  events DownloadEvent[]
  reports LinkReport[]

  @@map("download_links")
}

// Ghi nhận một lượt mua — cho phép tải lại miễn phí trong thời hạn thay vì trừ tiền mỗi lần bấm (UC11)
model DownloadGrant {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  downloadLinkId String
  downloadLink   DownloadLink @relation(fields: [downloadLinkId], references: [id], onDelete: Cascade)
  purchasedAt    DateTime     @default(now())
  expiresAt      DateTime?

  @@map("download_grants")
}

// Log mỗi lần sinh presigned URL — chống lạm dụng/chia sẻ link (UC24, UC25)
model DownloadEvent {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  downloadLinkId String
  downloadLink   DownloadLink @relation(fields: [downloadLinkId], references: [id], onDelete: Cascade)
  ipAddress      String
  createdAt      DateTime     @default(now())

  // Tải qua quota Subscription (miễn phí, không trừ $P) thay vì mua bằng $P — null = tải theo giá
  // $P bình thường (download-links.service.ts unlock(), không đổi gì ở nhánh đó). Dùng để tính
  // quota đã dùng theo từng kỳ Subscription (subscription.service.ts checkFreeDownloadEligibility)
  // bằng COUNT/DISTINCT trực tiếp trên bảng này thay vì 1 cột đếm riêng dễ lệch dữ liệu.
  subscriptionMembershipId String?
  subscriptionMembership   SubscriptionMembership? @relation(fields: [subscriptionMembershipId], references: [id], onDelete: SetNull)

  @@index([subscriptionMembershipId, downloadLinkId])
  @@index([subscriptionMembershipId, createdAt])
  @@map("download_events")
}

enum LinkReportStatus {
  PENDING
  RESOLVED
}

// Báo lỗi link die (UC25) — hàng chờ xử lý cho Moderator+ (dùng chung quyền download.manage_links,
// không thêm permission key mới để tránh đổi RBAC trên DB production đang chạy thật).
model LinkReport {
  id             String           @id @default(cuid())
  downloadLinkId String
  downloadLink   DownloadLink     @relation(fields: [downloadLinkId], references: [id], onDelete: Cascade)
  reporterId     String
  reporter       User             @relation("LinkReportReporter", fields: [reporterId], references: [id])
  note           String?
  status         LinkReportStatus @default(PENDING)
  resolvedById   String?
  resolvedBy     User?            @relation("LinkReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@map("link_reports")
}

enum FeedbackStatus {
  PENDING
  RESOLVED
}

// Góp ý chung từ người dùng (modal Feedback toàn site, khác LinkReport chỉ báo lỗi 1 link tải cụ
// thể) — cho gửi ẩn danh (authorId null) nên có thêm name/email tự nhập để Admin còn cách liên hệ
// lại khi cần. Dùng chung permission feedback.manage cho hàng chờ xử lý (Moderator+), không tách
// permission riêng theo module vì khối lượng dự kiến thấp.
model Feedback {
  id           String         @id @default(cuid())
  authorId     String?
  author       User?          @relation("FeedbackAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  name         String?
  email        String?
  message      String
  status       FeedbackStatus @default(PENDING)
  resolvedById String?
  resolvedBy   User?          @relation("FeedbackResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@map("feedbacks")
}

enum UserActivityType {
  LOGIN
  VIEW_POST
  DEPOSIT
  VISIT_PROFILE
  COMMENT
  SUBSCRIPTION_PURCHASED
}

// User Activity — tab "Hoạt động" trong trang Hồ sơ, công khai (GET /users/:id/activity, ai cũng
// xem được, giống trang Hồ sơ công khai). metadata tuỳ type: VIEW_POST {postTitle, postSlug};
// DEPOSIT {amountVnd, transactionCode}; VISIT_PROFILE {profileUserId, profileDisplayName};
// COMMENT {postId, postTitle, commentId}; LOGIN không cần metadata.
model UserActivity {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserActivityType
  metadata  Json?
  ipAddress String?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("user_activities")
}

enum AuditAction {
  ROLE_ASSIGNED
  ROLE_REMOVED
  WALLET_ADJUSTED
  STORAGE_PROVIDER_KEY_CHANGED
  // Admin/role có quyền download.bypass tạo link tải không trừ $P, không ghi WalletTransaction/
  // DownloadGrant/DownloadEvent (xem download-links.service.ts adminBypassUnlock) — vẫn audit log
  // lại vì đây là năng lực nhạy cảm dễ bị lạm dụng, dù không hiện trong lịch sử người dùng thấy được.
  DOWNLOAD_BYPASSED
}

// Audit log thao tác nhạy cảm (PLAN.md 4.3) — đổi quyền, chỉnh ví tay, đổi key R2/S3. Khác
// UserActivity (nhật ký hành vi công khai của user): AuditLog chỉ Admin xem được, ghi actor (người
// thực hiện) + target (đối tượng bị tác động, vd userId được đổi role/tài khoản được cộng $P).
model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String
  actor       User        @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      AuditAction
  targetType  String?
  targetId    String?
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────── Ví $P & SePay (Phase 3) ─────────────────────────

enum WalletTxType {
  TOPUP
  PURCHASE
  ADMIN_ADJUST
  REFUND
}

enum WalletTxStatus {
  PENDING
  SUCCESS
  FAILED
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0) // đơn vị $P, luôn cập nhật trong cùng transaction với WalletTransaction
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String         @id @default(cuid())
  walletId      String
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          WalletTxType
  amount        Int // dương = cộng, âm = trừ
  balanceAfter  Int
  status        WalletTxStatus @default(PENDING)
  referenceType String? // "sepay_topup" | "download_link" | "admin_adjust" | ...
  referenceId   String?
  note          String? // Lý do Admin điều chỉnh tay (WALLET_ADJUST) — đối soát khi webhook SePay không khớp
  createdAt     DateTime       @default(now())

  sepayTransaction SepayTransaction?
  topupOrder       TopupOrder?

  @@map("wallet_transactions")
}

enum TopupOrderStatus {
  PENDING
  SUCCESS
  EXPIRED
}

// "Yêu cầu nạp tiền" — khác WalletTransaction (chỉ ghi giao dịch ĐÃ xảy ra, bắt buộc balanceAfter).
// TopupOrder biểu diễn trạng thái "đang chờ chuyển khoản" có hạn (expiresAt) trước khi webhook xác nhận.
model TopupOrder {
  id                  String             @id @default(cuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id])
  code                String             @unique // nội dung CK đối soát, vd "GD482134"
  amountVnd           Int
  amountP             Int // số $P sẽ cộng nếu khớp đúng amountVnd, tính theo tỉ giá/gói tại thời điểm tạo
  status              TopupOrderStatus   @default(PENDING)
  expiresAt           DateTime
  walletTransactionId String?            @unique
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  createdAt           DateTime           @default(now())

  @@map("topup_orders")
}

// Đối soát webhook SePay — unique theo mã giao dịch để chống cộng tiền trùng khi webhook gọi lại (UC23)
model SepayTransaction {
  id                   String             @id @default(cuid())
  sepayTransactionCode String             @unique
  walletTransactionId  String?            @unique
  walletTransaction    WalletTransaction? @relation(fields: [walletTransactionId], references: [id])
  amountVnd            Int
  pCredited            Int
  rawPayload           Json
  status               WalletTxStatus     @default(PENDING)
  createdAt            DateTime           @default(now())

  @@map("sepay_transactions")
}

// ───────────────────────── Gói Subscription/VIP (bổ sung 2026-08-11) ─────────────────────────

// Admin tự tạo/sửa ở /admin/settings/subscription. totalDownloadLimit/dailyDownloadLimit: null =
// không giới hạn — 2 field độc lập nhau (dailyDownloadLimit là tuỳ chọn bổ sung, không bắt buộc đi
// kèm totalDownloadLimit).
model SubscriptionPlan {
  id                 String   @id @default(cuid())
  name               String
  durationDays       Int
  priceVnd           Int
  totalDownloadLimit Int?
  dailyDownloadLimit Int?
  isActive           Boolean  @default(true)
  order              Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders      SubscriptionOrder[]
  memberships SubscriptionMembership[]

  @@map("subscription_plans")
}

enum SubscriptionOrderStatus {
  PENDING
  SUCCESS
  EXPIRED
}

// Yêu cầu mua gói Subscription — THANH TOÁN RIÊNG qua SePay (không đụng ví $P theo yêu cầu), cùng
// thiết kế TopupOrder (code đối soát + expiresAt 30 phút) nhưng "code" bắt đầu bằng "SUB" (khác
// "GD" của TopupOrder.code) để webhook phân biệt được ngay bằng cách thử khớp lần lượt, không cần
// sửa 1 dòng nào trong TopupOrder/SepayService.matchAndCredit() hiện có (xem
// sepay-webhook.controller.ts và subscription.service.ts matchAndActivateFromWebhook()).
model SubscriptionOrder {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id])
  planId    String
  plan      SubscriptionPlan        @relation(fields: [planId], references: [id])
  code      String                  @unique
  amountVnd Int
  status    SubscriptionOrderStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime                @default(now())

  membership SubscriptionMembership?

  @@map("subscription_orders")
}

enum SubscriptionMembershipStatus {
  ACTIVE
  EXPIRED
}

// Kỳ Subscription đang/đã hiệu lực của 1 user. Mua gói mới trong lúc còn 1 kỳ ACTIVE sẽ đánh dấu kỳ
// cũ EXPIRED ngay và tạo kỳ mới bắt đầu từ lúc mua (KHÔNG cộng dồn thời hạn kỳ cũ) — xem
// subscription.service.ts activateFromOrder(). Tối đa 1 membership ACTIVE/user tại 1 thời điểm.
model SubscriptionMembership {
  id        String                       @id @default(cuid())
  userId    String
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      SubscriptionPlan             @relation(fields: [planId], references: [id])
  orderId   String?                      @unique
  order     SubscriptionOrder?           @relation(fields: [orderId], references: [id])
  startsAt  DateTime                     @default(now())
  endsAt    DateTime
  status    SubscriptionMembershipStatus @default(ACTIVE)
  createdAt DateTime                     @default(now())

  downloadEvents DownloadEvent[]

  @@index([userId, status])
  @@map("subscription_memberships")
}

// Đối soát webhook SePay CHO SUBSCRIPTION — bảng RIÊNG, không dùng chung SepayTransaction (cố ý,
// để không đụng 1 dòng nào vào bảng/luồng nạp $P đang chạy thật). unique theo sepayTransactionCode
// cùng cơ chế chống race/webhook gọi lại như SepayTransaction: check tồn tại trước (fast path cho
// retry tuần tự), rồi tạo record bên trong CÙNG transaction với activateFromOrder() — 2 webhook
// trùng đến gần như đồng thời sẽ có 1 cái vi phạm unique constraint lúc insert, transaction đó rollback
// an toàn (không kích hoạt 2 lần), SePay sẽ tự retry và lần sau rơi vào fast path.
model SubscriptionSepayTransaction {
  id                   String         @id @default(cuid())
  sepayTransactionCode String         @unique
  subscriptionOrderId  String?
  amountVnd            Int
  rawPayload           Json
  status               WalletTxStatus @default(PENDING)
  createdAt            DateTime       @default(now())

  @@map("subscription_sepay_transactions")
}

// ───────────────────────── Cài đặt hệ thống ─────────────────────────

// Key/value chung cho SEO toàn site, tỉ giá $P, cấu hình SePay... (UC15, UC21)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// Thư viện Media (kiểu WordPress) — mọi file upload qua /media được ghi 1 dòng ở đây (tên gốc,
// kích thước, người tải lên) để trang quản trị liệt kê/tìm kiếm được; file vật lý vẫn nằm chung
// đĩa cục bộ ./uploads với endpoint /uploads cũ (avatar, ảnh trong bài viết) — 2 nguồn ghi khác
// nhau, không ép các endpoint upload cũ phải đổi hành vi.
model MediaFile {
  id           String   @id @default(cuid())
  fileName     String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  // null = Local (uploads/posts/... trên đĩa, hành vi gốc). Có giá trị = tải lên StorageProvider
  // R2/S3 tương ứng (media.service.ts) — key vẫn theo convention posts/yyyy/mm/dd/... như local.
  storageProviderId String?
  storageProvider   StorageProvider? @relation(fields: [storageProviderId], references: [id], onDelete: SetNull)

  @@map("media_files")
}

enum DbBackupStatus {
  SUCCESS
  FAILED
}

// Lịch sử mỗi lần backup DB (thủ công qua nút "Backup ngay" hoặc cron hàng ngày) — không ràng buộc
// FK cứng tới StorageProvider (provider có thể bị Admin xoá sau, lịch sử backup cũ vẫn giữ nguyên
// để biết đã từng backup, dù không còn tải lại được file thật). Ghi cả bản ghi FAILED (không chỉ
// SUCCESS) để Admin thấy ngay backup có lỗi thay vì im lặng biến mất — xem DbBackupService.runBackup.
model DbBackupRecord {
  id                String         @id @default(cuid())
  status            DbBackupStatus
  sizeBytes         BigInt?
  storageProviderId String?
  objectKey         String?
  errorMessage      String?
  createdAt         DateTime       @default(now())

  @@map("db_backup_records")
}

enum CloudUploadStatus {
  SUCCESS
  FAILED
  CANCELLED
}

// Lịch sử upload file lên bucket qua trang "Upload File Cloud" (hàng đợi nền, xem
// frontend/src/context/upload-queue-context.tsx) — ghi lại cả FAILED/CANCELLED (không chỉ SUCCESS)
// để admin tra cứu được vì sao 1 lần upload không ra file, không chỉ thấy "biến mất". Không ràng
// buộc FK cứng tới StorageProvider (provider có thể bị xoá sau) — cùng lý do đã áp dụng cho
// DbBackupRecord, snapshot providerLabel riêng để lịch sử cũ vẫn đọc được tên dù provider đã đổi/xoá.
model CloudUploadRecord {
  id                String            @id @default(cuid())
  fileName          String
  objectKey         String?
  folder            String?
  sizeBytes         BigInt?
  status            CloudUploadStatus
  errorMessage      String?
  storageProviderId String?
  providerLabel     String?
  uploadedById      String?
  uploadedBy        User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@map("cloud_upload_records")
}

// Đăng ký nhận bản tin (UC bổ sung 2026-08-10) — độc lập với User (cho phép khách chưa có tài
// khoản đăng ký bằng email bất kỳ, giống Feedback ẩn danh). KHÔNG lưu token huỷ đăng ký trong DB —
// link "Huỷ đăng ký" trong mỗi email digest ký bằng HMAC-SHA256(JWT_ACCESS_SECRET, id), verify bằng
// cách tính lại chứ không so khớp với giá trị đã lưu (xem newsletter.service.ts signUnsubscribeToken/
// verifyUnsubscribeToken) — khác EmailVerificationToken/PasswordResetToken vì token ở đây cần DÙNG
// LẠI được nhiều lần (mỗi kỳ digest), không phải one-time.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@map("newsletter_subscribers")
}
