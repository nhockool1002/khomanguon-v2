# Sao chép file này thành .env khi chạy local (pnpm run dev ngoài Docker, trỏ vào backend
# chạy sẵn ở :4000).

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret dùng chung với backend (REVALIDATE_SECRET trong backend/.env) — backend gọi
# POST /api/revalidate kèm header x-revalidate-secret sau khi Admin bấm "Xoá cache" trên topbar,
# route handler này xác thực secret rồi purge cache ISR của Next.js (xem
# src/app/api/revalidate/route.ts). Đặt trên Vercel dashboard ở production, không dùng file này.
REVALIDATE_SECRET="dev-only-change-me-revalidate-secret"
